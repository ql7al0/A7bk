-- 1. تزييف دولة الجهاز إلى فرنسا (LocalizationService Hook)
local LocalizationService = game:GetService("LocalizationService")

if hookmetatable then
    local rawmeta = getrawmetatable(game)
    local oldNamecall = rawmeta.__namecall
    setreadonly(rawmeta, false)

    rawmeta.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if self == LocalizationService and method == "GetCountryRegionForPlayerAsync" then
            return "FR" -- رمز دولة فرنسا
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(rawmeta, true)
end

-- 2. تزييف نص البنق في واجهات اللعبة ليصبح ما بين 11 و 16 ms
local function fakePingDisplay()
    for _, guiObj in pairs(game:GetDescendants()) do
        if guiObj:IsA("TextLabel") or guiObj:IsA("TextBox") then
            -- البحث عن النصوص التي تحتوي على كلمة Ping أو ms
            local text = guiObj.Text
            if text:find("ms") or text:lower():find("ping") then
                -- استبدال الرقم الظاهر برقم وهمي بين 11 و 16
                local fakeValue = math.random(11, 16)
                guiObj.Text = fakeValue .. " ms"
            end
        end
    end
end

-- تحديث النص باستمرار
task.spawn(function()
    while task.wait(0.5) do
        pcall(fakePingDisplay)
    end
end)
