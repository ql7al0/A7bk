-- سكربت تعديل الأيقونة التي فوق رأس الشخصية (على شاشتك فقط)
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- استبدل هذا الرقم بـ Asset ID لأيقونة السوني أو الكونسول التي تريدها
local NEW_ICON = "rbxassetid://13192080031" 

local function updateCharacterIcon()
    local character = LocalPlayer.Character
    if not character then return end

    -- البحث داخل مجسم الشخصية والرأس عن أي BillboardGui أو واجهة أسماء
    for _, gui in pairs(character:GetDescendants()) do
        if gui:IsA("ImageLabel") or gui:IsA("ImageButton") then
            -- تغيير أي صورة موجودة فوق الشخصية إلى أيقونة الكونسول
            gui.Image = NEW_ICON
        end
    end
end

task.spawn(function()
    while task.wait(0.5) do
        pcall(updateCharacterIcon)
    end
end)
